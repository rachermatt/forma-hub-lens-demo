# Demo-only configuration. Copy to .env.local for local development.
# Never commit filled-in credentials or session keys.
LENS_MODE=demo

# Use a separate APS Traditional Web App with User Profile access.
# Autodesk is used only for sign-in; no real hub integration is required.
APS_CLIENT_ID=
APS_CLIENT_SECRET=

# Must exactly match a callback registered on the demo APS application.
# Vercel Production: https://forma-hub-lens.vercel.app/api/aps/callback
APS_CALLBACK_URL=http://localhost:3000/api/aps/callback

# Exactly 64 hexadecimal characters: 32 cryptographically random bytes.
# Generate locally with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep one stable value across instances in the same deployment environment.
DEMO_SESSION_SECRET=

# Optional external link to a separately hosted live application.
# This never enables live mode or switches this application's dataset.
LENS_LIVE_URL=
